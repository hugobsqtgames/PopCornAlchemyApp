{
  "expo": {
    "name": "Pop-Corn Alchemy",
    "slug": "popcorn-alchemy",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "popcornalchemy",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF6EC",
    "ios": {
      "bundleIdentifier": "com.hugobsqt.popcornalchemy",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hugobsqt.popcornalchemy",
      "adaptiveIcon": {
        "backgroundColor": "#FFC93C",
        "foregroundImage": "./assets/images/splash-icon.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF6EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#15121E",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "fr",
              "es",
              "de",
              "it",
              "pt-BR",
              "nl",
              "pl",
              "tr",
              "ru",
              "ja",
              "ko",
              "zh-Hans"
            ]
          }
        }
      ],
      "expo-screen-orientation",
      "expo-asset",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37f058a6-fb03-4d56-97cb-56bbeaf05c20"
      }
    },
    "owner": "aazerty12",
    "locales": {
      "en": "./locales/en.json",
      "fr": "./locales/fr.json",
      "es": "./locales/es.json",
      "de": "./locales/de.json",
      "it": "./locales/it.json",
      "pt-BR": "./locales/pt-BR.json",
      "nl": "./locales/nl.json",
      "pl": "./locales/pl.json",
      "tr": "./locales/tr.json",
      "ru": "./locales/ru.json",
      "ja": "./locales/ja.json",
      "ko": "./locales/ko.json",
      "zh-Hans": "./locales/zh-Hans.json"
    }
  }
}
