{
  "expo": {
    "name": "Pop-Corn Alchemy",
    "slug": "popcorn-alchemy",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "popcornalchemy",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF6EC",
    "ios": {
      "bundleIdentifier": "com.hugobsqt.popcornalchemy",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.hugobsqt.popcornalchemy"
        ],
        "com.apple.developer.icloud-services": [
          "CloudKit"
        ],
        "com.apple.developer.ubiquity-kvstore-identifier": "$(TeamIdentifierPrefix)$(CFBundleIdentifier)"
      }
    },
    "android": {
      "package": "com.hugobsqt.popcornalchemy",
      "adaptiveIcon": {
        "backgroundColor": "#FFC93C",
        "foregroundImage": "./assets/images/splash-icon.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF6EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#15121E",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "fr",
              "es",
              "de",
              "it",
              "pt-BR",
              "nl",
              "pl",
              "tr",
              "ru",
              "ja",
              "ko",
              "zh-Hans"
            ]
          }
        }
      ],
      "expo-screen-orientation",
      "expo-asset",
      "expo-notifications",
      "expo-iap",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458507309",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
